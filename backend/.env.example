# Server
PORT=3000
# Comma-separated web origins allowed by CORS (REST + Socket.io)
CORS_ORIGINS=http://localhost:3001
FRONTEND_URL=http://localhost:3001

# Database (Postgres with pgvector)
DATABASE_URL=postgresql://postgres:password@localhost:5433/Orbit

# Redis (cache, rate limiting, BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
# Requests per minute per IP. Raise only for local load tests.
THROTTLE_LIMIT=100

# Clerk
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_WEBHOOK_SECRET=whsec_replace_me

# Stripe
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# AWS S3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace_me
AWS_SECRET_ACCESS_KEY=replace_me
AWS_S3_BUCKET_NAME=replace_me

# Google Gemini
GEMINI_API_KEY=replace_me

# Resend (edu verification emails)
RESEND_API_KEY=re_replace_me
